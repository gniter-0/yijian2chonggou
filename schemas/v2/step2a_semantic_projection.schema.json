{
  "$defs": {
    "ContinuationRecord": {
      "additionalProperties": false,
      "description": "A deterministic page-end marker that blocks an all-items enumeration.",
      "properties": {
        "continuation_id": {
          "pattern": "^continuation:[0-9a-f]{24}$",
          "title": "Continuation Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ContinuationState",
          "default": "partial_continuation"
        },
        "page_num": {
          "minimum": 1,
          "title": "Page Num",
          "type": "integer"
        },
        "source_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Manifest Sha256",
          "type": "string"
        },
        "anchor_span_ids": {
          "items": {
            "type": "string"
          },
          "title": "Anchor Span Ids",
          "type": "array"
        },
        "required_adjacent_page_num": {
          "minimum": 1,
          "title": "Required Adjacent Page Num",
          "type": "integer"
        },
        "basis": {
          "maxLength": 500,
          "minLength": 8,
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "continuation_id",
        "page_num",
        "source_manifest_sha256",
        "anchor_span_ids",
        "required_adjacent_page_num",
        "basis"
      ],
      "title": "ContinuationRecord",
      "type": "object"
    },
    "ContinuationState": {
      "description": "Page-local continuation state; page-only input never closes a chain.",
      "enum": [
        "partial_continuation"
      ],
      "title": "ContinuationState",
      "type": "string"
    },
    "CoverageRequirement": {
      "enum": [
        "required",
        "optional",
        "not_required"
      ],
      "title": "CoverageRequirement",
      "type": "string"
    },
    "EvidenceAnchorSpan": {
      "additionalProperties": false,
      "description": "One deterministic, policy-bound selectable subrange of immutable Evidence.",
      "properties": {
        "anchor_span_id": {
          "pattern": "^span:[0-9a-f]{24}$",
          "title": "Anchor Span Id",
          "type": "string"
        },
        "span_version": {
          "default": "evidence_anchor_span_v1",
          "title": "Span Version",
          "type": "string"
        },
        "parent_evidence_id": {
          "title": "Parent Evidence Id",
          "type": "string"
        },
        "parent_evidence_kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "canonical_text": {
          "minLength": 1,
          "title": "Canonical Text",
          "type": "string"
        },
        "exact_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Exact Text Sha256",
          "type": "string"
        },
        "content_policy_id": {
          "minLength": 1,
          "title": "Content Policy Id",
          "type": "string"
        },
        "content_policy_revision": {
          "minimum": 1,
          "title": "Content Policy Revision",
          "type": "integer"
        },
        "content_policy_fingerprint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Policy Fingerprint Sha256",
          "type": "string"
        },
        "policy_decision": {
          "$ref": "#/$defs/PolicyDecision"
        },
        "source_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Manifest Sha256",
          "type": "string"
        }
      },
      "required": [
        "anchor_span_id",
        "parent_evidence_id",
        "parent_evidence_kind",
        "start",
        "end",
        "canonical_text",
        "exact_text_sha256",
        "content_policy_id",
        "content_policy_revision",
        "content_policy_fingerprint_sha256",
        "policy_decision",
        "source_manifest_sha256"
      ],
      "title": "EvidenceAnchorSpan",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "heading",
        "paragraph",
        "list_group",
        "list_item",
        "table",
        "table_row",
        "table_cell",
        "formula",
        "figure",
        "diagram_node",
        "diagram_edge",
        "caption",
        "example",
        "exercise",
        "exam_tag",
        "header_footer",
        "watermark",
        "page_number",
        "decorative"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "PolicyDecision": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 8,
          "title": "Evidence Id",
          "type": "string"
        },
        "semantic_role": {
          "$ref": "#/$defs/SemanticRole"
        },
        "disposition": {
          "$ref": "#/$defs/PolicyDisposition"
        },
        "coverage_requirement": {
          "$ref": "#/$defs/CoverageRequirement"
        },
        "decision_state": {
          "$ref": "#/$defs/PolicyDecisionState",
          "default": "auto_classified"
        },
        "policy_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_revision": {
          "minimum": 1,
          "title": "Policy Revision",
          "type": "integer"
        },
        "reason": {
          "minLength": 3,
          "title": "Reason",
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        }
      },
      "required": [
        "evidence_id",
        "semantic_role",
        "disposition",
        "coverage_requirement",
        "policy_id",
        "policy_revision",
        "reason"
      ],
      "title": "PolicyDecision",
      "type": "object"
    },
    "PolicyDecisionState": {
      "enum": [
        "unclassified",
        "auto_classified",
        "needs_manual_review",
        "manually_resolved"
      ],
      "title": "PolicyDecisionState",
      "type": "string"
    },
    "PolicyDisposition": {
      "enum": [
        "included",
        "excluded_by_policy",
        "archived",
        "manual_review",
        "ignored_noise"
      ],
      "title": "PolicyDisposition",
      "type": "string"
    },
    "ProjectionDecisionRecord": {
      "additionalProperties": false,
      "description": "Derived policy application for one immutable Evidence unit.",
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "source_semantic_role": {
          "$ref": "#/$defs/SemanticRole"
        },
        "policy_decision": {
          "$ref": "#/$defs/PolicyDecision"
        },
        "selection": {
          "$ref": "#/$defs/ProjectionSelection"
        },
        "additional_selections": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProjectionSelection"
          },
          "title": "Additional Selections",
          "type": "array"
        },
        "reason": {
          "minLength": 3,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_kind",
        "source_semantic_role",
        "policy_decision",
        "selection",
        "reason"
      ],
      "title": "ProjectionDecisionRecord",
      "type": "object"
    },
    "ProjectionSelection": {
      "enum": [
        "direct_input",
        "controlled_diagram_summary",
        "excluded_by_policy",
        "excluded_by_type",
        "excluded_as_table_duplicate",
        "excluded_by_audit",
        "manual_review"
      ],
      "title": "ProjectionSelection",
      "type": "string"
    },
    "ReviewedDiagramEdgeInput": {
      "additionalProperties": false,
      "properties": {
        "source_node_id": {
          "pattern": "^node-[a-z0-9][a-z0-9._-]*$",
          "title": "Source Node Id",
          "type": "string"
        },
        "target_node_id": {
          "pattern": "^node-[a-z0-9][a-z0-9._-]*$",
          "title": "Target Node Id",
          "type": "string"
        },
        "relation": {
          "minLength": 1,
          "title": "Relation",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "basis": {
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "source_node_id",
        "target_node_id",
        "relation",
        "evidence_ids",
        "basis",
        "confidence"
      ],
      "title": "ReviewedDiagramEdgeInput",
      "type": "object"
    },
    "ReviewedDiagramNodeInput": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "pattern": "^node-[a-z0-9][a-z0-9._-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "node_id",
        "label",
        "evidence_ids"
      ],
      "title": "ReviewedDiagramNodeInput",
      "type": "object"
    },
    "ReviewedStructuralDiagramInput": {
      "additionalProperties": false,
      "properties": {
        "review_id": {
          "pattern": "^diagram:[0-9a-f]{24}$",
          "title": "Review Id",
          "type": "string"
        },
        "figure_evidence_id": {
          "title": "Figure Evidence Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "diagram_type": {
          "minLength": 1,
          "title": "Diagram Type",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/ReviewedDiagramNodeInput"
          },
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/ReviewedDiagramEdgeInput"
          },
          "title": "Edges",
          "type": "array"
        }
      },
      "required": [
        "review_id",
        "figure_evidence_id",
        "title",
        "diagram_type",
        "nodes",
        "edges"
      ],
      "title": "ReviewedStructuralDiagramInput",
      "type": "object"
    },
    "SemanticRole": {
      "enum": [
        "core",
        "worked_example",
        "exercise_question",
        "exercise_option",
        "exercise_answer",
        "exercise_explanation",
        "exam_tag",
        "heading",
        "caption",
        "header_footer",
        "watermark",
        "page_number",
        "decorative",
        "unknown"
      ],
      "title": "SemanticRole",
      "type": "string"
    },
    "TableGridIntegrityRecord": {
      "additionalProperties": false,
      "description": "Non-destructive assessment of one declared Evidence table grid.",
      "properties": {
        "table_evidence_id": {
          "title": "Table Evidence Id",
          "type": "string"
        },
        "declared_row_count": {
          "minimum": 1,
          "title": "Declared Row Count",
          "type": "integer"
        },
        "declared_column_count": {
          "minimum": 1,
          "title": "Declared Column Count",
          "type": "integer"
        },
        "observed_row_count": {
          "minimum": 0,
          "title": "Observed Row Count",
          "type": "integer"
        },
        "observed_cell_count": {
          "minimum": 0,
          "title": "Observed Cell Count",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/TableGridIntegrityStatus"
        },
        "issue_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Issue Codes",
          "type": "array"
        },
        "repair_id": {
          "anyOf": [
            {
              "pattern": "^table-repair:[0-9a-f]{24}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repair Id"
        }
      },
      "required": [
        "table_evidence_id",
        "declared_row_count",
        "declared_column_count",
        "observed_row_count",
        "observed_cell_count",
        "status"
      ],
      "title": "TableGridIntegrityRecord",
      "type": "object"
    },
    "TableGridIntegrityStatus": {
      "enum": [
        "passed",
        "passed_with_reviewed_repair",
        "manual_review"
      ],
      "title": "TableGridIntegrityStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable, policy-filtered source manifest for one Step 2A page.",
  "properties": {
    "projection_id": {
      "pattern": "^step2a-projection:[0-9a-f]{24}$",
      "title": "Projection Id",
      "type": "string"
    },
    "projection_version": {
      "default": "step2a_semantic_projection_v5_table_atomic_continuation",
      "title": "Projection Version",
      "type": "string"
    },
    "sample_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Sample Id",
      "type": "string"
    },
    "page_num": {
      "minimum": 1,
      "title": "Page Num",
      "type": "integer"
    },
    "source_manifest_path": {
      "minLength": 1,
      "title": "Source Manifest Path",
      "type": "string"
    },
    "source_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Manifest Sha256",
      "type": "string"
    },
    "source_document_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Document Sha256",
      "type": "string"
    },
    "content_policy_id": {
      "minLength": 1,
      "title": "Content Policy Id",
      "type": "string"
    },
    "content_policy_revision": {
      "minimum": 1,
      "title": "Content Policy Revision",
      "type": "integer"
    },
    "content_policy_fingerprint_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Policy Fingerprint Sha256",
      "type": "string"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/ProjectionDecisionRecord"
      },
      "title": "Decisions",
      "type": "array"
    },
    "direct_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Direct Evidence Ids",
      "type": "array"
    },
    "context_only_evidence_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Context Only Evidence Ids",
      "type": "array"
    },
    "anchor_spans": {
      "items": {
        "$ref": "#/$defs/EvidenceAnchorSpan"
      },
      "title": "Anchor Spans",
      "type": "array"
    },
    "table_grid_integrity": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TableGridIntegrityRecord"
      },
      "title": "Table Grid Integrity",
      "type": "array"
    },
    "continuation_records": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ContinuationRecord"
      },
      "title": "Continuation Records",
      "type": "array"
    },
    "reviewed_table_repair_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Reviewed Table Repair Ids",
      "type": "array"
    },
    "table_repair_sidecar_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Table Repair Sidecar Sha256"
    },
    "controlled_diagrams": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReviewedStructuralDiagramInput"
      },
      "title": "Controlled Diagrams",
      "type": "array"
    },
    "diagram_review_sidecar_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Diagram Review Sidecar Sha256"
    }
  },
  "required": [
    "projection_id",
    "sample_id",
    "page_num",
    "source_manifest_path",
    "source_manifest_sha256",
    "source_document_sha256",
    "content_policy_id",
    "content_policy_revision",
    "content_policy_fingerprint_sha256",
    "decisions",
    "direct_evidence_ids",
    "anchor_spans"
  ],
  "title": "Step2ASemanticProjection",
  "type": "object"
}
