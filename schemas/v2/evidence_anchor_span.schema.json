{
  "$defs": {
    "CoverageRequirement": {
      "enum": [
        "required",
        "optional",
        "not_required"
      ],
      "title": "CoverageRequirement",
      "type": "string"
    },
    "EvidenceKind": {
      "enum": [
        "heading",
        "paragraph",
        "list_group",
        "list_item",
        "table",
        "table_row",
        "table_cell",
        "formula",
        "figure",
        "diagram_node",
        "diagram_edge",
        "caption",
        "example",
        "exercise",
        "exam_tag",
        "header_footer",
        "watermark",
        "page_number",
        "decorative"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "PolicyDecision": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 8,
          "title": "Evidence Id",
          "type": "string"
        },
        "semantic_role": {
          "$ref": "#/$defs/SemanticRole"
        },
        "disposition": {
          "$ref": "#/$defs/PolicyDisposition"
        },
        "coverage_requirement": {
          "$ref": "#/$defs/CoverageRequirement"
        },
        "decision_state": {
          "$ref": "#/$defs/PolicyDecisionState",
          "default": "auto_classified"
        },
        "policy_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_revision": {
          "minimum": 1,
          "title": "Policy Revision",
          "type": "integer"
        },
        "reason": {
          "minLength": 3,
          "title": "Reason",
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        }
      },
      "required": [
        "evidence_id",
        "semantic_role",
        "disposition",
        "coverage_requirement",
        "policy_id",
        "policy_revision",
        "reason"
      ],
      "title": "PolicyDecision",
      "type": "object"
    },
    "PolicyDecisionState": {
      "enum": [
        "unclassified",
        "auto_classified",
        "needs_manual_review",
        "manually_resolved"
      ],
      "title": "PolicyDecisionState",
      "type": "string"
    },
    "PolicyDisposition": {
      "enum": [
        "included",
        "excluded_by_policy",
        "archived",
        "manual_review",
        "ignored_noise"
      ],
      "title": "PolicyDisposition",
      "type": "string"
    },
    "SemanticRole": {
      "enum": [
        "core",
        "worked_example",
        "exercise_question",
        "exercise_option",
        "exercise_answer",
        "exercise_explanation",
        "exam_tag",
        "heading",
        "caption",
        "header_footer",
        "watermark",
        "page_number",
        "decorative",
        "unknown"
      ],
      "title": "SemanticRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One deterministic, policy-bound selectable subrange of immutable Evidence.",
  "properties": {
    "anchor_span_id": {
      "pattern": "^span:[0-9a-f]{24}$",
      "title": "Anchor Span Id",
      "type": "string"
    },
    "span_version": {
      "default": "evidence_anchor_span_v1",
      "title": "Span Version",
      "type": "string"
    },
    "parent_evidence_id": {
      "title": "Parent Evidence Id",
      "type": "string"
    },
    "parent_evidence_kind": {
      "$ref": "#/$defs/EvidenceKind"
    },
    "start": {
      "minimum": 0,
      "title": "Start",
      "type": "integer"
    },
    "end": {
      "exclusiveMinimum": 0,
      "title": "End",
      "type": "integer"
    },
    "canonical_text": {
      "minLength": 1,
      "title": "Canonical Text",
      "type": "string"
    },
    "exact_text_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Exact Text Sha256",
      "type": "string"
    },
    "content_policy_id": {
      "minLength": 1,
      "title": "Content Policy Id",
      "type": "string"
    },
    "content_policy_revision": {
      "minimum": 1,
      "title": "Content Policy Revision",
      "type": "integer"
    },
    "content_policy_fingerprint_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Policy Fingerprint Sha256",
      "type": "string"
    },
    "policy_decision": {
      "$ref": "#/$defs/PolicyDecision"
    },
    "source_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Manifest Sha256",
      "type": "string"
    }
  },
  "required": [
    "anchor_span_id",
    "parent_evidence_id",
    "parent_evidence_kind",
    "start",
    "end",
    "canonical_text",
    "exact_text_sha256",
    "content_policy_id",
    "content_policy_revision",
    "content_policy_fingerprint_sha256",
    "policy_decision",
    "source_manifest_sha256"
  ],
  "title": "EvidenceAnchorSpan",
  "type": "object"
}
