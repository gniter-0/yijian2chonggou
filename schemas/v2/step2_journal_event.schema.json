{
  "$defs": {
    "Step2DecoderConfig": {
      "additionalProperties": false,
      "description": "All output-affecting generation controls must participate in cache identity.",
      "properties": {
        "temperature": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "max_tokens": {
          "default": 1400,
          "maximum": 4000,
          "minimum": 64,
          "title": "Max Tokens",
          "type": "integer"
        },
        "response_format": {
          "$ref": "#/$defs/Step2ResponseFormat",
          "default": "json_schema_strict"
        }
      },
      "title": "Step2DecoderConfig",
      "type": "object"
    },
    "Step2JournalOutcome": {
      "enum": [
        "request_started",
        "cache_hit",
        "success",
        "failed",
        "unknown_outcome",
        "reconciled_terminal"
      ],
      "title": "Step2JournalOutcome",
      "type": "string"
    },
    "Step2RequestIdentity": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "$ref": "#/$defs/Step2Stage"
        },
        "request_version": {
          "minLength": 1,
          "title": "Request Version",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Sha256",
          "type": "string"
        },
        "relay_fingerprint_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Relay Fingerprint Sha256",
          "type": "string"
        },
        "prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "response_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Schema Sha256",
          "type": "string"
        },
        "decoder": {
          "$ref": "#/$defs/Step2DecoderConfig"
        },
        "projection_id": {
          "anyOf": [
            {
              "pattern": "^step2a-projection:[0-9a-f]{24}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projection Id"
        },
        "projection_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projection Sha256"
        },
        "source_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Manifest Sha256"
        },
        "content_policy_fingerprint_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Policy Fingerprint Sha256"
        },
        "manual_reissue_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Reissue Reason"
        },
        "request_id": {
          "pattern": "^step2[ab]-request:[0-9a-f]{64}$",
          "title": "Request Id",
          "type": "string"
        },
        "cache_key": {
          "pattern": "^step2-cache:[0-9a-f]{64}$",
          "title": "Cache Key",
          "type": "string"
        },
        "idempotency_key": {
          "pattern": "^step2-[0-9a-f]{64}$",
          "title": "Idempotency Key",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "request_version",
        "model",
        "payload_sha256",
        "relay_fingerprint_sha256",
        "prompt_sha256",
        "response_schema_sha256",
        "decoder",
        "request_id",
        "cache_key",
        "idempotency_key"
      ],
      "title": "Step2RequestIdentity",
      "type": "object"
    },
    "Step2ResponseFormat": {
      "enum": [
        "json_schema_strict",
        "json_object"
      ],
      "title": "Step2ResponseFormat",
      "type": "string"
    },
    "Step2Stage": {
      "enum": [
        "step2a",
        "step2b"
      ],
      "title": "Step2Stage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "pattern": "^step2-event:[0-9a-f]{64}$",
      "title": "Event Id",
      "type": "string"
    },
    "recorded_at_utc": {
      "pattern": "^.+Z$",
      "title": "Recorded At Utc",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/Step2JournalOutcome"
    },
    "request": {
      "$ref": "#/$defs/Step2RequestIdentity"
    },
    "provider_request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Request Id"
    },
    "http_status": {
      "anyOf": [
        {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Http Status"
    },
    "error_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Type"
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "reconciled_terminal_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/Step2JournalOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "event_id",
    "recorded_at_utc",
    "outcome",
    "request"
  ],
  "title": "Step2JournalEvent",
  "type": "object"
}
