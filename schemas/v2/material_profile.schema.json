{
  "$defs": {
    "DedupScope": {
      "enum": [
        "within_document",
        "within_collection",
        "cross_collection_candidate_only"
      ],
      "title": "DedupScope",
      "type": "string"
    },
    "EffectiveWindow": {
      "additionalProperties": false,
      "properties": {
        "effective_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective From"
        },
        "effective_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective To"
        },
        "standard_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard Id"
        }
      },
      "title": "EffectiveWindow",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "textbook",
        "lecture_note",
        "regulation",
        "standard",
        "question_bank",
        "past_exam",
        "slide_deck",
        "other"
      ],
      "title": "SourceKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "profile_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Profile Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "collection_id": {
      "pattern": "^[a-z0-9][a-z0-9._/-]*$",
      "title": "Collection Id",
      "type": "string"
    },
    "exam_family": {
      "title": "Exam Family",
      "type": "string"
    },
    "exam_level": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exam Level"
    },
    "subject_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Subject Id",
      "type": "string"
    },
    "subject_name": {
      "title": "Subject Name",
      "type": "string"
    },
    "source_kind": {
      "$ref": "#/$defs/SourceKind"
    },
    "source_language": {
      "default": "zh-CN",
      "title": "Source Language",
      "type": "string"
    },
    "edition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Edition"
    },
    "jurisdiction": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Jurisdiction"
    },
    "effective_window": {
      "$ref": "#/$defs/EffectiveWindow",
      "default": {
        "effective_from": null,
        "effective_to": null,
        "standard_id": null
      }
    },
    "content_policy_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Content Policy Id",
      "type": "string"
    },
    "content_policy_revision": {
      "minimum": 1,
      "title": "Content Policy Revision",
      "type": "integer"
    },
    "layout_profile_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Layout Profile Id",
      "type": "string"
    },
    "taxonomy_profile_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Taxonomy Profile Id",
      "type": "string"
    },
    "validation_profile_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Validation Profile Id",
      "type": "string"
    },
    "card_profile_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Card Profile Id",
      "type": "string"
    },
    "dedup_scope": {
      "$ref": "#/$defs/DedupScope",
      "default": "within_collection"
    }
  },
  "required": [
    "profile_id",
    "revision",
    "display_name",
    "collection_id",
    "exam_family",
    "subject_id",
    "subject_name",
    "source_kind",
    "content_policy_id",
    "content_policy_revision",
    "layout_profile_id",
    "taxonomy_profile_id",
    "validation_profile_id",
    "card_profile_id"
  ],
  "title": "MaterialProfile",
  "type": "object"
}
