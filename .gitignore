# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 虚拟环境（uv sync 重建）
.venv/

# 测试产物（规范 T3：仓库相对产物统一收口于 .test-tmp/）。通配到 .test-tmp*/ 是因为
# 历史上跑过 --basetemp .test-tmp-xxx 的同级目录，原来的 `.test-tmp/` 匹配不到它们。
.test-tmp*/
.pytest_cache/
.coverage
htmlcov/

# 工具缓存
.ruff_cache/
.mypy_cache/

# 密钥与本地配置（规范 T6）
.env
.env.*

# 编辑器
.idea/
.vscode/

# 金样资产镜像（≈120MB，自 yijian2 只读镜像而来，可按 engineering_skeleton.md §3 重建；不入引擎仓 git）
/data/
/input_pdf_公路/
/docs/v2/baselines/

# New-exam workspaces (live_pipeline_driver_design.md section 3.2; runbook section 1 code/data split)
/exams/*/input_pdf/
/exams/*/data/

# 新考试工作区（runbook §1：代码与数据分仓；T4b §3.2）
/exams/*/input_pdf/
/exams/*/data/

# 仓根体检日志：census / vision 两支盘点脚本的落地输出，属一次性排查产物，不入 git。
# 按文件名精确登记而非 `*.log` 通配——通配会把将来「本该随提交一起审阅」的日志
# 也悄悄吞掉。cm30 已用 .test-tmp/leakscan.py 扫过这两份：SCANNED=2 HIT_FILES=0 HIT_LINES=0。
/census_s2.log
/vision_s2.log
# Local debugging and generated run artifacts
/.c2c*/
/.pytest-tmp-*/
/.cursor/
/t/
/t[0-9]/
/tmp/
/pilot_runs/
